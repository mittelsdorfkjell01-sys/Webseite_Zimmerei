{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.zimmerei-mittelsdorf.de" }],
      "destination": "https://zimmerei-mittelsdorf.de/:path*",
      "permanent": true
    },
    { "source": "/kontakt.html",    "destination": "/#kontakt",    "permanent": true },
    { "source": "/leistungen.html", "destination": "/#leistungen", "permanent": true },
    { "source": "/projekte.html",   "destination": "/#projekte",   "permanent": true },
    { "source": "/referenzen.html", "destination": "/#projekte",   "permanent": true },
    { "source": "/ueber-uns.html",  "destination": "/#ueber-uns",  "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
